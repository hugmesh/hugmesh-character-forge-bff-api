{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // The cross-language contract fixture (character-forge/contract/server-contract.fixtures.json)
    // is imported by BOTH the karma spec and the Java ClientContractFixturesTest — one file,
    // two suites, so neither side can drift from the other unnoticed.
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ES2022",
    "experimentalDecorators": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
