{
  "name": "@hugmesh/character-forge",
  "version": "0.0.0",
  "description": "Character Forge — 3D character maker (native-federation remote 'character-forge'). Maps VN characters (character-studio SVG packs) to Char3DConfig and embeds the Godot studio canvas.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve character-forge",
    "build": "ng build character-forge",
    "build:character-forge": "ng build character-forge",
    "test": "ng test character-forge --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test character-forge"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@softarc/native-federation-node": "^3.5.5",
    "es-module-shims": "^2.8.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "^5.1.15",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "typescript": "~6.0.3"
  }
}
